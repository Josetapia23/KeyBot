# Configuración del bot KeyDrop
# Copia este archivo como .env y completa tus datos

# Tiempo de espera entre participaciones (en milisegundos)
# 2 minutos = 120000 ms
WAIT_TIME=120000

# Modo headless (true = navegador oculto, false = navegador visible)
HEADLESS=true

# URL del sorteo
GIVEAWAY_URL=https://keydrop.com/es/giveaways/list

# Opcional: Si necesitas login automático (por ahora no lo usaremos)
# KEYDROP_EMAIL=tu_email@ejemplo.com
# KEYDROP_PASSWORD=tu_password
