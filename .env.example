# Configuración del bot KeyDrop
# Copia este archivo como .env y completa tus datos

# ============================================
# OPCIÓN 1: USAR TU NAVEGADOR BRAVE (RECOMENDADO)
# ============================================
# Activa esto para usar tu Brave con tu sesión ya iniciada
USE_BRAVE=true

# Ruta del ejecutable de Brave (Windows)
BRAVE_PATH=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe

# Ruta del perfil de Brave (Windows - NO MODIFICAR a menos que uses un perfil personalizado)
# Por defecto usa %LOCALAPPDATA%\BraveSoftware\Brave-Browser\User Data
# BRAVE_USER_DATA=C:\Users\TU_USUARIO\AppData\Local\BraveSoftware\Brave-Browser\User Data

# ============================================
# OPCIÓN 2: USAR CHROMIUM DE PLAYWRIGHT
# ============================================
# Si prefieres usar Chromium en lugar de Brave, cambia USE_BRAVE a false
# USE_BRAVE=false
# HEADLESS=true

# ============================================
# CONFIGURACIÓN GENERAL
# ============================================

# Tiempo de espera entre participaciones (en milisegundos)
# 2 minutos = 120000 ms
WAIT_TIME=120000

# URL del sorteo
GIVEAWAY_URL=https://keydrop.com/es/giveaways/list
